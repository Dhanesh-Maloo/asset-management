# Copy to .env for local runs. On Railway, set these as service variables instead. Never commit real values.
MONGO_URL=mongodb://localhost:27017
DB_NAME=asset_management
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Transactional email (Zoho ZeptoMail, India data centre). Sender is fixed in mailer.py: Ownix <noreply@ownix.pro>
ZEPTOMAIL_TOKEN=Zoho-enczapikey your-token-here
ZEPTOMAIL_API_URL=https://cpaas.zoho.in/v1.1/email
